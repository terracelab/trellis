{
  "name": "@terracelab/trellis-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "화면 블록(복사형 소스, D-51) · 플랫폼 기본 기능 타입 · 샘플 데이터. 앱은 trellis add로 소스를 복사해 소유한다",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
