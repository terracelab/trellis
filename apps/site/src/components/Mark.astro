---
// Trellis 표식(D-149). 모양은 lib/mark.json 하나에서 나온다. favicon도 같은 파일로 만든다(scripts/favicons.mjs).
// 페이지 안에서는 회사 색 토큰으로 칠해서 색을 바꾸면 같이 바뀐다. favicon은 로고의 파랑 그대로다.
import mark from '../lib/mark.json';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['tl-site-mark', className]}
  viewBox={`0 0 ${mark.width} ${mark.height}`}
  width={mark.width}
  height={mark.height}
  aria-hidden="true"
  focusable="false"
>
  <path d={mark.d}></path>
</svg>
