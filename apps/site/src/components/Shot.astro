---
// 화면 블록 그림 한 장. 라이트 · 다크 두 장을 두고 테마에 맞는 쪽만 보인다(안 보이는 쪽은 lazy라 받지 않는다).
// large는 1440 원본(@2x)을 srcset에 더한다. 그림은 scripts/shots.mjs가 만든다.
import featured from '../lib/featured.json';
import { blockById, isPhone, shotFile } from '../lib/blocks';
import { to } from '../lib/site';

interface Props {
  id: string;
  /** 그림 설명. 그림이 내용일 때(블록 목록) 넣고, 옆 글이 이미 말하는 장식 그림은 비운다 */
  alt?: string;
  large?: boolean;
  eager?: boolean;
  class?: string;
}
const { id, alt = '', large = false, eager = false, class: className } = Astro.props;
const block = blockById(id);
const phone = isPhone(block);
const [width, height] = phone ? [390, 844] : [720, 450];
const hasLarge = large && !phone && featured.large.includes(id);
const src = (dark: boolean, big = false) =>
  to(`blocks/${shotFile(id)}${big ? '@2x' : ''}${dark ? '--dark' : ''}.jpg`);
---

{
  [false, true].map((dark) => (
    <img
      class:list={['tl-site-shot', dark ? 'tl-site-when-dark' : 'tl-site-when-light', className]}
      src={src(dark)}
      srcset={hasLarge ? `${src(dark)} 720w, ${src(dark, true)} 1440w` : undefined}
      sizes={hasLarge ? '(max-width: 767px) 100vw, 600px' : undefined}
      width={width}
      height={height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      data-phone={phone || undefined}
    />
  ))
}
