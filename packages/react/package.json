{
  "name": "@terracelab/trellis-react",
  "version": "1.0.0",
  "description": "웹 React 컴포넌트",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "trellis",
    "terracelab",
    "react",
    "components",
    "design-system",
    "data-grid",
    "charts"
  ],
  "homepage": "https://trellis.terracelab.co.kr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terracelab/trellis.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/terracelab/trellis/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@terracelab/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "@terracelab/source": "./src/charts/index.ts",
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./core": {
      "@terracelab/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./form": {
      "@terracelab/source": "./src/form/index.ts",
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./styles.css": {
      "@terracelab/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json",
    "./docs/*": "./dist/docs/*"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && node ../../scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-virtual": "3.14.21",
    "@terracelab/trellis-contracts": "workspace:*",
    "@terracelab/trellis-icons": "workspace:*",
    "@terracelab/trellis-tokens": "workspace:*",
    "react-day-picker": "9.14.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "typescript": "~6.0.3",
    "zod": "4.6.7"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
