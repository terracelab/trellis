{
  "name": "__NAME__",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm ds:build && pnpm --filter ./apps/web build",
    "typecheck": "pnpm --filter ./apps/web typecheck",
    "lint": "eslint .",
    "check": "node scripts/check.mjs",
    "ds:build": "pnpm --filter \"@terracelab/trellis-react...\" build",
    "ds:doctor": "node trellis/packages/skill/bin/trellis-skill.mjs doctor",
    "ds:docs": "node trellis/packages/skill/bin/trellis-skill.mjs docs",
    "ds:skill": "node trellis/packages/skill/bin/trellis-skill.mjs install",
    "ds:add": "node trellis/scripts/add-block.mjs",
    "ds:theme": "node trellis/packages/tokens/scripts/gen-theme.mjs --out apps/web/src/theme.css",
    "ds:update": "git -C trellis switch main && git -C trellis pull --ff-only && pnpm install && pnpm ds:build && pnpm ds:skill && pnpm ds:theme --refresh && pnpm ds:add --outdated"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@terracelab/eslint-plugin-trellis": "workspace:*",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
